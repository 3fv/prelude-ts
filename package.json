{
  "name": "@3fv/prelude-ts",
  "version": "0.8.43",
  "description": "A typescript functional programming library",
  "main": "./lib/cjs/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/esm/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js",
      "types": "./lib/esm/index.d.ts"
    },
    "./*": {
      "import": "./lib/esm/*.js",
      "require": "./lib/cjs/*.js",
      "types": "./lib/esm/*.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3fv/prelude-ts.git"
  },
  "dependencies": {
    "@3fv/guard": "^1.4.38",
    "hamt_plus": "^1.0.2",
    "list": "^2.0.19"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.9.0",
    "@types/request-promise-native": "^1.0.17",
    "@types/shelljs": "^0.8.15",
    "benchmark": "^2.1.4",
    "browserify": "^16.5.0",
    "cross-env": "^7.0.3",
    "hamt": "^2.2.2",
    "immutable": "^4.0.0",
    "mocha": "^12.0.3",
    "mocha-testcheck": "^1.0.0-rc.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^2.4.1",
    "prettier-package-json": "^2.6.0",
    "request": "^2.88.0",
    "request-promise-native": "^1.0.9",
    "shelljs": "^0.8.5",
    "source-map-support": "^0.5.21",
    "typedoc": "^0.7.2",
    "typescript": "^5.5.4",
    "uglify-js": "^3.6.0",
    "zx": "^8.2.2"
  },
  "keywords": [
    "typescript",
    "functional-programming",
    "immutable",
    "collections"
  ],
  "author": "Emmanuel Touzery",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/emmanueltouzery/prelude.ts/issues"
  },
  "homepage": "https://github.com/emmanueltouzery/prelude.ts#readme",
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "build:watch": "yarn run build --watch",
    "build:test": "tsc -p tsconfig.test.json",
    "test:generate": "yarn test:clean && yarn build:test && node ./lib/test/tests/Comments.js",
    "test:clean": "rm -rf ./generated/apidoc-tests ./lib/test",
    "test:run": "mocha --throw-deprecation --timeout 60000 --ignore 'lib/test/tests/Comments.js' 'lib/test/tests/*.js' 'lib/test/generated/apidoc-tests/*.js'",
    "test:run:watch": "mocha -w --throw-deprecation --timeout 60000 --ignore 'lib/test/tests/Comments.js' 'lib/test/tests/*.js' 'lib/test/generated/apidoc-tests/*.js'",
    "test": "run-s build test:generate build:test test:run",
    "test:watch": "run-s build test:generate build:test test:run:watch",
    "clean": "yarn test:clean; rm -Rf ./lib ./generated",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docgen": "./scripts/make_doc.sh",
    "benchmarks": "yarn build && tsc -p tsconfig.benchmarks.json && node ./lib/test/benchmarks/bench.js",
    "preversion": "yarn build",
    "release": "gh workflow run release.yml --ref master -f bump=patch"
  },
  "files": [
    "lib",
    "src",
    "LICENSE.TXT",
    "README.md",
    "package.json"
  ]
}
